rules_version = '2';

// Adaptive Emergency Triage Agent - Firestore security rules.
//
// SHAPE OF THE TRUST MODEL (spec 3.1):
//   The frontend holds no API keys and performs no orchestration. It READS case
//   state live and WRITES nothing. Every mutation that matters - new evidence, a
//   risk score, a routing decision, a timeline entry, a tool-call record - is
//   written by the server using the Admin SDK, which bypasses these rules
//   entirely.
//
//   So these rules exist to constrain the CLIENT, and the client's only job is
//   to read its own case. Everything else is denied by default.
//
// WHAT THESE RULES MATCH ON:
//   `cases/{caseId}.ownerUid` is a REQUIRED field on CaseState
//   (packages/shared/src/types/case-state.ts) and is validated by
//   caseStateSchema. The server sets it at case creation from the uid the
//   device supplies after anonymous sign-in. If it were absent - which the type
//   system now prevents - every read below would evaluate false and the case
//   would be invisible with no error the UI could surface.
//
//   `relayUids` is OPTIONAL, so it is read with `.get(..., [])`.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsCase(caseData) {
      // Anonymous Auth gives each device a stable uid at no cost on the free
      // Spark plan. A case is readable by its owner and by any contact the
      // server has explicitly listed as a relay participant (5.5).
      return isSignedIn() && (
        caseData.ownerUid == request.auth.uid ||
        request.auth.uid in caseData.get('relayUids', [])
      );
    }

    function caseDataFor(caseId) {
      return get(/databases/$(database)/documents/cases/$(caseId)).data;
    }

    // --- Cases -------------------------------------------------------------
    match /cases/{caseId} {
      allow read: if ownsCase(resource.data);

      // The client NEVER writes to a case.
      //
      // An earlier draft allowed the client to set `gateHoldRequest` and
      // `cancelRequest` so the server could observe those intents. That was
      // removed rather than implemented: the app already reaches the server
      // over HTTP (POST /cases/:id/confirm and /cancel), so a Firestore write
      // path would be a second, unused way to influence a case - and the one
      // the press-and-hold gate is least able to police. Neither field exists
      // on CaseState, so allowing them would also have let a client write keys
      // the schema rejects.
      allow write: if false;

      // --- Subcollections: read-only to the client -------------------------
      match /timeline/{entryId} {
        allow read: if ownsCase(caseDataFor(caseId));
        allow write: if false;
      }

      match /toolCalls/{callId} {
        allow read: if ownsCase(caseDataFor(caseId));
        allow write: if false;
      }

      match /turns/{turnId} {
        allow read: if ownsCase(caseDataFor(caseId));
        allow write: if false;
      }
    }

    // --- Patient profiles ---------------------------------------------------
    // The One-Tap Emergency Card is the patient's own data: they may edit it.
    // Create is separated from update/delete because on a create `resource` is
    // null - a single `allow read, write` clause touching `resource.data` would
    // evaluate against nothing and deny every create.
    match /patients/{patientId} {
      allow read, update, delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // --- Hospital overlay ---------------------------------------------------
    // Simulated specialty + bed data. Public read so the map renders; writes
    // are seeded by the server only.
    match /hospitals/{osmId} {
      allow read: if true;
      allow write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
