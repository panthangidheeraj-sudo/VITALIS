# ============================================================================
# Adaptive Emergency Triage Agent — backend environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# The FRONTEND never receives any of these values — all external API calls are
# made server-side (spec §3.1 security requirement). The web app's own public
# Firebase config lives separately in packages/web/.env.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8787

# --- Firebase Admin (free Spark plan) ----------------------------------------
# Path to the service-account JSON downloaded from
#   Firebase console > Project settings > Service accounts > Generate new private key
# Store this file OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# --- Groq (reasoning / orchestration — never the clinical risk score) --------
# https://console.groq.com/keys  (free tier, no card)
GROQ_API_KEY=
GROQ_MODEL_TEXT=openai/gpt-oss-120b
GROQ_MODEL_VISION=openai/gpt-oss-120b

# --- Infermedica (deterministic clinical scoring — /parse, /search, /triage) --
# https://developer.infermedica.com/  (free developer trial, no card)
# NOTE: trial accounts have a hard call cap specifically on /triage.
INFERMEDICA_APP_ID=
INFERMEDICA_APP_KEY=
INFERMEDICA_BASE_URL=https://api.infermedica.com/v3

# --- Twilio (emergency-contact notifications) --------------------------------
# Free trial. India A2P SMS requires DLT registration, so WhatsApp sandbox is
# the default demo channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
# THE SAFETY SWITCH. Anything other than exactly "true" means DRY RUN: messages
# are composed, shown, and recorded on the timeline as `suppressed`, but never
# put on the wire. Default to dry run while rehearsing - this is the only
# adapter in the system that contacts a real person and cannot be undone.
TWILIO_LIVE=false

# --- Google Gemini (VISION ONLY) ---------------------------------------------
# https://aistudio.google.com/apikey  (free tier, no card)
# Used for injury-photo description and nothing else - Groq keeps every text
# task. Without this key the photo path is disabled and says so on screen
# rather than silently returning nothing.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# gemini-2.0-flash and gemini-2.5-flash both now return 404 "no longer
# available to new users" on a freshly-issued key. gemini-3.6-flash is what
# Google's own error body points at and is what this build was verified against.
GEMINI_VISION_MODEL=gemini-3.6-flash

# --- WHO ICD-11 (standardised condition coding) ------------------------------
# https://icd.who.int/icdapi  (free, registration required)
# OAuth2 client-credentials, NOT a single API key. Used only to label an
# already-derived category on the doctor handoff card; it cannot affect a risk
# tier. Without these the coding port falls back to a mock.
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=
# Optional overrides. Leave the release unset to track WHO's current one.
ICD11_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
ICD11_BASE_URL=https://id.who.int
ICD11_RELEASE=

# --- Keyless / no-auth services ----------------------------------------------
# MedlinePlus (NIH/NLM) — plain-language grounding + citations.
# Two different services, deliberately both listed:
#   Connect  — CODE lookup (ICD-10/SNOMED/RxCUI in, topic out). Cannot take
#              free text, so it is unused until ICD-11 codes feed into it.
#   wsearch  — free-text health-topic search. This is what the adapter calls.
MEDLINEPLUS_BASE_URL=https://connect.medlineplus.gov/service
MEDLINEPLUS_SEARCH_URL=https://wsearch.nlm.nih.gov/ws/query
# Wikipedia — general-explanation FALLBACK only, never a primary clinical
# source. Results are returned as degraded so the patient is told the source.
WIKIPEDIA_BASE_URL=https://en.wikipedia.org
# RxNorm / RxNav (NIH) — medication NAME normalisation only. The drug-drug
# interaction endpoints were discontinued in January 2024; no interaction
# claim may be derived from this source.
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
# OpenStreetMap — real hospital locations without a billing card
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real contact address in the User-Agent.
OSM_CONTACT_EMAIL=

# --- Degradation / demo controls ---------------------------------------------
# Force the local deterministic scorer instead of Infermedica (for offline demo
# runs and for rehearsing the fallback banner). "true" | "false"
FORCE_LOCAL_SCORER=false
# Replay the fixture clock instead of wall time, so the 7:00 -> 7:05 escalation
# trace is reproducible on camera. "true" | "false"
USE_FIXTURE_CLOCK=false
