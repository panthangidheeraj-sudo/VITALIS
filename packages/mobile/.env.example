# Mobile app environment (Expo).
#
# EXPO_PUBLIC_* values are compiled INTO the app bundle and are readable by
# anyone with the APK. That is fine for everything here — the Firebase web
# config is public by design (Firestore rules, not secrecy, protect the data)
# and the API URL is just an address. No Groq / Infermedica / Twilio key ever
# belongs in this file; those live only in the server's root .env (spec §3.1).

# --- Orchestrator ------------------------------------------------------------
# On an EMULATOR, localhost works.
# On a PHYSICAL DEVICE it does not — "localhost" means the phone itself.
#
#   - Phone on the SAME Wi-Fi as your computer: use your computer's LAN IP.
#     `npx expo start` prints it; it looks like http://192.168.1.42:8787
#
#   - Phone on ANY OTHER network (a different Wi-Fi, mobile data, a different
#     city, a teammate testing remotely): a LAN IP cannot work — it is not
#     routable from outside that Wi-Fi. Deploy packages/server somewhere
#     public (Render, Fly, Railway, ...) and point this at THAT URL instead,
#     e.g. https://your-service.onrender.com — no trailing slash.
#
# Restart `npx expo start` after changing this — Expo inlines it at bundle
# time, so a reload alone will not pick up a new value.
EXPO_PUBLIC_API_URL=http://localhost:8787

# --- Firebase web config -----------------------------------------------------
# Firebase console > Project settings > General > Your apps > Web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google sign-in (optional) -----------------------------------------------
# Anonymous auth is the PRIMARY sign-in and the app is fully usable without any
# of these. Google sign-in only makes an identity portable across devices.
# Create OAuth client ids at console.cloud.google.com for the same Firebase
# project. These are public values - they identify the app, they authorise
# nothing on their own, which is why they are safe as EXPO_PUBLIC_*.
# Google issues a DIFFERENT client id per platform; the wrong one fails with an
# opaque redirect_uri_mismatch.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
