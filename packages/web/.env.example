# Firebase web app config — from Firebase console > Project settings > General
# > Your apps > Web. These values are public by design (protected by
# firestore.rules, not secrecy) but still live in .env, not hardcoded, so
# swapping Firebase projects doesn't touch source.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
